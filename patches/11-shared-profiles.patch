+++ b/Swiftgram/SGSimpleSettings/Sources/AyuGramProfileSync.swift
@@ -0,0 +1,435 @@
+import Foundation
+import Security
+
+public struct AyuGramSharedProfile: Codable, Equatable {
+    public var telegramId: String
+    public var registered: Bool
+    public var badge: String?
+    public var fakePremium: Bool?
+    public var emojiId: String?
+    public var statusUntil: Int32?
+    public var revision: Int?
+    public var updatedAt: Int64?
+
+    public var peerId: Int64? { Int64(telegramId) }
+    public var localStatus: AyuGramLocalStatus? {
+        guard registered, fakePremium == true else { return nil }
+        if let expiry = statusUntil, TimeInterval(expiry) <= Date().timeIntervalSince1970 { return nil }
+        return AyuGramLocalStatus(fileId: emojiId.flatMap(Int64.init), expirationDate: statusUntil)
+    }
+}
+
+public protocol AyuGramProfileTokenStore: AnyObject {
+    func read(accountId: Int64, installationId: String) -> String?
+    @discardableResult func write(_ token: String?, accountId: Int64, installationId: String) -> Bool
+}
+
+private final class AyuGramKeychainTokenStore: AyuGramProfileTokenStore {
+    private func query(accountId: Int64, installationId: String) -> [String: Any] {
+        return [kSecClass as String: kSecClassGenericPassword,
+                kSecAttrService as String: "org.ayugram.shared-profile.v1",
+                kSecAttrAccount as String: "\(installationId).\(accountId)"]
+    }
+    func read(accountId: Int64, installationId: String) -> String? {
+        var attributes = query(accountId: accountId, installationId: installationId)
+        attributes[kSecReturnData as String] = true
+        attributes[kSecMatchLimit as String] = kSecMatchLimitOne
+        var item: CFTypeRef?
+        guard SecItemCopyMatching(attributes as CFDictionary, &item) == errSecSuccess,
+              let data = item as? Data else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+    func write(_ token: String?, accountId: Int64, installationId: String) -> Bool {
+        let attributes = query(accountId: accountId, installationId: installationId)
+        guard let token else {
+            let result = SecItemDelete(attributes as CFDictionary)
+            return result == errSecSuccess || result == errSecItemNotFound
+        }
+        let changes: [String: Any] = [kSecValueData as String: Data(token.utf8),
+                                     kSecAttrAccessible as String: kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly]
+        let result = SecItemUpdate(attributes as CFDictionary, changes as CFDictionary)
+        if result == errSecSuccess { return true }
+        guard result == errSecItemNotFound else { return false }
+        return SecItemAdd(attributes.merging(changes) { _, new in new } as CFDictionary, nil) == errSecSuccess
+    }
+}
+
+private final class AyuGramNoRedirectDelegate: NSObject, URLSessionTaskDelegate {
+    func urlSession(_ session: URLSession, task: URLSessionTask,
+                    willPerformHTTPRedirection response: HTTPURLResponse, newRequest request: URLRequest,
+                    completionHandler: @escaping (URLRequest?) -> Void) {
+        completionHandler(nil)
+    }
+}
+
+public final class AyuGramProfileSync {
+    public static let shared = AyuGramProfileSync()
+    public static let didChange = Notification.Name("AyuGram.SharedProfile.didChange")
+    public static let baseURL = URL(string: "https://ayugram-sync.ayugram-status.workers.dev")!
+    private struct Cached: Codable {
+        var profile: AyuGramSharedProfile
+        var fetchedAt: TimeInterval
+        var generation: Int64
+    }
+    private struct Lookup: Decodable { var profiles: [AyuGramSharedProfile]; var serverTime: Int64 }
+    private struct Link: Decodable { var pollToken: String; var startUrl: String; var expiresAt: Int64 }
+    private struct Poll: Decodable { var token: String?; var telegramId: String?; var expiresAt: Int64? }
+    private struct Conflict: Decodable { var profile: AyuGramSharedProfile }
+    private let defaults: UserDefaults
+    private let tokenStore: AyuGramProfileTokenStore
+    private let session: URLSession
+    private let installationId: String
+    private let lock = NSLock()
+    private var cache: [String: Cached]
+    private var states: [Int64: String] = [:]
+    private var connected: Set<Int64> = []
+    private var accountId: Int64?
+    private var token: String?
+    private var foreground = true
+    private var epoch = 0
+    private var tasks: [UUID: URLSessionDataTask] = [:]
+    private var visible: [Int64: TimeInterval] = [:]
+    private var timer: DispatchSourceTimer?
+    private var pendingLink: Link?
+    private var polling = false
+    private var refreshing = false
+    private var saving = false
+    private var pendingPublish: (Bool, AyuGramLocalStatus?)?
+    private var nextRequestAt: TimeInterval = 0
+    private var retryDelay: TimeInterval = 5
+    private var lastOwnFetch: TimeInterval = 0
+    private var expiredStatuses: Set<Int64> = []
+    private static let cacheKey = "ayugram.shared-profiles.cache.v1"
+
+    public init(defaults: UserDefaults = .standard, tokenStore: AyuGramProfileTokenStore? = nil,
+                session: URLSession? = nil) {
+        self.defaults = defaults
+        self.tokenStore = tokenStore ?? AyuGramKeychainTokenStore()
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.requestCachePolicy = .reloadIgnoringLocalCacheData
+        configuration.timeoutIntervalForRequest = 15
+        configuration.timeoutIntervalForResource = 20
+        self.session = session ?? URLSession(configuration: configuration, delegate: AyuGramNoRedirectDelegate(), delegateQueue: nil)
+        let key = "ayugram.shared-profiles.installation.v1"
+        let installation = defaults.string(forKey: key) ?? UUID().uuidString
+        self.installationId = installation
+        defaults.set(installation, forKey: key)
+        self.cache = defaults.data(forKey: Self.cacheKey).flatMap { try? JSONDecoder().decode([String: Cached].self, from: $0) } ?? [:]
+    }
+
+    deinit { timer?.cancel(); for task in tasks.values { task.cancel() } }
+
+    public func profile(peerId: Int64) -> AyuGramSharedProfile? {
+        lock.lock(); defer { lock.unlock() }
+        return cache[String(peerId)]?.profile
+    }
+    public func generation(peerId: Int64) -> Int64 {
+        lock.lock(); defer { lock.unlock() }
+        return cache[String(peerId)]?.generation ?? 0
+    }
+    public func badge(peerId: Int64) -> String? {
+        if peerId == 1272887902 { return "owner" }
+        guard let profile = profile(peerId: peerId), profile.registered, profile.badge == "member" else { return nil }
+        return "member"
+    }
+    public func hasPremium(peerId: Int64) -> Bool {
+        guard let profile = profile(peerId: peerId) else { return false }
+        return profile.registered && profile.fakePremium == true
+    }
+    public func state(accountId: Int64) -> String {
+        lock.lock(); defer { lock.unlock() }
+        return states[accountId] ?? "disconnected"
+    }
+    public func isConnected(accountId: Int64) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        return connected.contains(accountId)
+    }
+    public func setForeground(_ active: Bool) {
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.foreground = active
+            if active { self.tick() }
+        }
+    }
+    public func observe(peerId: Int64, accountId: Int64) {
+        guard peerId > 0, accountId > 0 else { return }
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.activate(accountId)
+            self.visible[peerId] = Date().timeIntervalSince1970
+            self.tick()
+        }
+    }
+    private func activate(_ id: Int64) {
+        guard accountId != id else { return }
+        let previousAccount = accountId
+        epoch += 1
+        for task in tasks.values { task.cancel() }
+        tasks.removeAll()
+        accountId = id
+        token = tokenStore.read(accountId: id, installationId: installationId)
+        visible.removeAll()
+        pendingLink = nil
+        polling = false; refreshing = false; saving = false
+        pendingPublish = nil
+        nextRequestAt = 0; retryDelay = 5
+        lastOwnFetch = 0
+        setState(token == nil ? "disconnected" : "connected", account: id)
+        if let own = profile(peerId: id), own.registered { applyOwn(own, account: id) }
+        else if previousAccount != nil { AyuGramSettings.shared.updateClient { $0.localPremium = false } }
+        if timer == nil {
+            let timer = DispatchSource.makeTimerSource(queue: .main)
+            timer.schedule(deadline: .now() + 2, repeating: 2)
+            timer.setEventHandler { [weak self] in self?.tick() }
+            self.timer = timer
+            timer.resume()
+        }
+    }
+    private func setState(_ value: String, account: Int64) {
+        lock.lock()
+        let changed = states[account] != value
+        states[account] = value
+        if token != nil && accountId == account { connected.insert(account) }
+        else { connected.remove(account) }
+        lock.unlock()
+        if changed { notify([]) }
+    }
+    private func notify(_ ids: [Int64]) {
+        NotificationCenter.default.post(name: Self.didChange, object: self, userInfo: ["peerIds": ids])
+    }
+    private func applyOwn(_ profile: AyuGramSharedProfile, account: Int64) {
+        guard accountId == account else { return }
+        let enabled = profile.registered && profile.fakePremium == true
+        if AyuGramSettings.shared.client.localPremium != enabled {
+            AyuGramSettings.shared.updateClient { $0.localPremium = enabled }
+        }
+        AyuGramSettings.shared.setLocalStatus(peerId: account, status: nil)
+    }
+    private func store(_ profiles: [AyuGramSharedProfile]) {
+        let now = Date().timeIntervalSince1970
+        var changed: [Int64] = []
+        lock.lock()
+        for profile in profiles {
+            guard let id = profile.peerId, id > 0 else { continue }
+            let old = cache[profile.telegramId]
+            let generation = old?.profile == profile ? old!.generation : max((old?.generation ?? 0) + 1, Int64(now * 1000))
+            cache[profile.telegramId] = Cached(profile: profile, fetchedAt: now, generation: generation)
+            if profile.statusUntil == nil || TimeInterval(profile.statusUntil!) > now { expiredStatuses.remove(id) }
+            if old?.profile != profile { changed.append(id) }
+        }
+        if cache.count > 1500 {
+            let excess = cache.sorted { $0.value.fetchedAt < $1.value.fetchedAt }.prefix(cache.count - 1500)
+            for entry in excess { cache.removeValue(forKey: entry.key) }
+        }
+        let encoded = try? JSONEncoder().encode(cache)
+        lock.unlock()
+        if let encoded { defaults.set(encoded, forKey: Self.cacheKey) }
+        if !changed.isEmpty { notify(changed) }
+    }
+    private func request(_ path: String, method: String = "GET", body: [String: Any]? = nil,
+                         authenticated: Bool = true, completion: @escaping (Int, Data?) -> Void) {
+        guard let id = accountId, !authenticated || token != nil else { completion(401, nil); return }
+        var request = URLRequest(url: Self.baseURL.appendingPathComponent(path))
+        request.httpMethod = method
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        if authenticated, let token { request.setValue("Bearer " + token, forHTTPHeaderField: "Authorization") }
+        if let body { request.httpBody = try? JSONSerialization.data(withJSONObject: body) }
+        let version = epoch, identifier = UUID()
+        let task = session.dataTask(with: request) { [weak self] data, response, error in
+            DispatchQueue.main.async {
+                guard let self, self.accountId == id, self.epoch == version else { return }
+                self.tasks.removeValue(forKey: identifier)
+                let status = error == nil ? (response as? HTTPURLResponse)?.statusCode ?? 0 : 0
+                if status == 0 || status >= 500 || status == 429 {
+                    self.nextRequestAt = Date().timeIntervalSince1970 + self.retryDelay
+                    self.retryDelay = min(60, self.retryDelay * 2)
+                } else {
+                    self.nextRequestAt = 0; self.retryDelay = 5
+                }
+                if authenticated && status == 401 {
+                    self.token = nil
+                    self.tokenStore.write(nil, accountId: id, installationId: self.installationId)
+                    self.setState("expired", account: id)
+                }
+                completion(status, data)
+            }
+        }
+        tasks[identifier] = task
+        task.resume()
+    }
+    private func tick() {
+        guard foreground, let id = accountId else { return }
+        expireCachedStatuses()
+        guard Date().timeIntervalSince1970 >= nextRequestAt else { return }
+        if pendingLink != nil { poll(account: id); return }
+        guard token != nil, !refreshing, !saving else { return }
+        let now = Date().timeIntervalSince1970
+        visible = visible.filter { now - $0.value < 90 }
+        if now - lastOwnFetch >= 60 { refreshOwn(account: id); return }
+        lock.lock()
+        let ids = visible.keys.filter { now - (cache[String($0)]?.fetchedAt ?? 0) >= 60 }.prefix(100).map(String.init)
+        lock.unlock()
+        guard !ids.isEmpty else { return }
+        refreshing = true
+        request("v1/profiles/lookup", method: "POST", body: ["telegramIds": ids]) { [weak self] status, data in
+            guard let self else { return }
+            self.refreshing = false
+            if status == 200, let data, let value = try? JSONDecoder().decode(Lookup.self, from: data) {
+                let requested = Set(ids)
+                self.store(value.profiles.filter { requested.contains($0.telegramId) })
+                if let own = value.profiles.first(where: { $0.peerId == id }) { self.applyOwn(own, account: id) }
+                self.setState("connected", account: id)
+                self.flushPublish(account: id)
+            } else {
+                self.pendingPublish = nil
+                if status != 401 { self.setState("error", account: id) }
+            }
+        }
+    }
+    private func expireCachedStatuses() {
+        let now = Date().timeIntervalSince1970
+        var changed: [Int64] = []
+        lock.lock()
+        for (key, entry) in cache {
+            guard let id = entry.profile.peerId, let expiry = entry.profile.statusUntil,
+                  TimeInterval(expiry) <= now, !expiredStatuses.contains(id) else { continue }
+            expiredStatuses.insert(id)
+            cache[key]?.generation += 1
+            changed.append(id)
+        }
+        lock.unlock()
+        if !changed.isEmpty { notify(changed) }
+    }
+    private func flushPublish(account: Int64) {
+        if let pending = pendingPublish {
+            pendingPublish = nil
+            publishNow(account: account, fakePremium: pending.0, status: pending.1)
+        }
+    }
+    public func refresh(accountId: Int64) {
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.activate(accountId)
+            self.lastOwnFetch = 0
+            self.tick()
+        }
+    }
+    private func refreshOwn(account: Int64) {
+        refreshing = true
+        lastOwnFetch = Date().timeIntervalSince1970
+        request("v1/me") { [weak self] status, data in
+            guard let self else { return }
+            self.refreshing = false
+            if status == 200, let data, let profile = try? JSONDecoder().decode(AyuGramSharedProfile.self, from: data), profile.peerId == account {
+                self.store([profile]); self.applyOwn(profile, account: account)
+                self.setState("connected", account: account)
+                self.flushPublish(account: account)
+            } else {
+                self.pendingPublish = nil
+                if status != 401 { self.setState("error", account: account) }
+            }
+        }
+    }
+    public func beginAuthentication(accountId: Int64, completion: @escaping (URL?) -> Void) {
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.activate(accountId)
+            self.setState("connecting", account: accountId)
+            self.request("v1/auth/start", method: "POST", body: ["telegramId": String(accountId)], authenticated: false) { [weak self] status, data in
+                guard let self else { return }
+                guard status == 200, let data, let link = try? JSONDecoder().decode(Link.self, from: data),
+                      link.expiresAt > Int64(Date().timeIntervalSince1970), let url = URL(string: link.startUrl),
+                      url.scheme == "https", url.host == "t.me", url.path == "/ayugrampremiumfakerbot" else {
+                    self.setState("error", account: accountId); completion(nil); return
+                }
+                self.pendingLink = link
+                completion(url)
+            }
+        }
+    }
+    private func poll(account: Int64) {
+        guard !polling, let link = pendingLink else { return }
+        guard link.expiresAt > Int64(Date().timeIntervalSince1970) else {
+            pendingLink = nil; setState("expired", account: account); return
+        }
+        polling = true
+        request("v1/auth/poll", method: "POST", body: ["pollToken": link.pollToken], authenticated: false) { [weak self] status, data in
+            guard let self else { return }
+            self.polling = false
+            if status == 202 { return }
+            guard status == 200, let data, let result = try? JSONDecoder().decode(Poll.self, from: data),
+                  result.telegramId == String(account), let token = result.token, token.count == 64,
+                  token.allSatisfy({ "0123456789abcdef".contains($0) }),
+                  (result.expiresAt ?? 0) > Int64(Date().timeIntervalSince1970) else {
+                if status == 410 { self.pendingLink = nil; self.setState("expired", account: account) }
+                else { self.setState("error", account: account) }
+                return
+            }
+            guard self.tokenStore.write(token, accountId: account, installationId: self.installationId) else {
+                self.setState("error", account: account); return
+            }
+            self.token = token
+            self.pendingLink = nil
+            self.setState("connected", account: account)
+            self.lastOwnFetch = 0
+            self.tick()
+        }
+    }
+    public func publish(accountId: Int64, fakePremium: Bool, status: AyuGramLocalStatus?) {
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.activate(accountId)
+            self.publishNow(account: accountId, fakePremium: fakePremium, status: status)
+        }
+    }
+    private func publishNow(account accountId: Int64, fakePremium: Bool, status: AyuGramLocalStatus?) {
+            guard self.token != nil else { return }
+            if self.saving || self.refreshing {
+                self.pendingPublish = (fakePremium, status); return
+            }
+            guard let own = self.profile(peerId: accountId), let revision = own.revision else {
+                self.pendingPublish = (fakePremium, status)
+                self.refreshOwn(account: accountId); return
+            }
+            self.saving = true
+            self.setState("saving", account: accountId)
+            let emojiId = fakePremium ? status?.fileId.map(String.init) : nil
+            let expiry = emojiId == nil ? nil : status?.expirationDate
+            let body: [String: Any] = ["fakePremium": fakePremium, "emojiId": emojiId.map { $0 as Any } ?? NSNull(),
+                                      "statusUntil": expiry.map { $0 as Any } ?? NSNull(), "expectedRevision": revision]
+            self.request("v1/me", method: "PUT", body: body) { [weak self] code, data in
+                guard let self else { return }
+                self.saving = false
+                if code == 200, let data, let profile = try? JSONDecoder().decode(AyuGramSharedProfile.self, from: data), profile.peerId == accountId {
+                    self.store([profile]); self.applyOwn(profile, account: accountId)
+                    self.setState("connected", account: accountId)
+                    self.flushPublish(account: accountId)
+                } else if code == 409, let data, let conflict = try? JSONDecoder().decode(Conflict.self, from: data), conflict.profile.peerId == accountId {
+                    self.store([conflict.profile]); self.applyOwn(conflict.profile, account: accountId)
+                    self.pendingPublish = nil
+                    self.setState("conflict", account: accountId)
+                } else {
+                    self.pendingPublish = nil
+                    if code != 401 { self.setState("error", account: accountId) }
+                }
+            }
+    }
+    public func disconnect(accountId: Int64) {
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            self.activate(accountId)
+            self.request("v1/session", method: "DELETE") { [weak self] code, _ in
+                guard let self else { return }
+                guard code == 200 || code == 401 else { self.setState("error", account: accountId); return }
+                self.epoch += 1
+                for task in self.tasks.values { task.cancel() }
+                self.tasks.removeAll()
+                self.token = nil
+                self.tokenStore.write(nil, accountId: accountId, installationId: self.installationId)
+                self.pendingLink = nil
+                self.pendingPublish = nil
+                self.setState("disconnected", account: accountId)
+            }
+        }
+    }
+}
