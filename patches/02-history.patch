diff --git a/Swiftgram/SGSettingsUI/Sources/AyuGramHistoryController.swift b/Swiftgram/SGSettingsUI/Sources/AyuGramHistoryController.swift
new file mode 100644
--- /dev/null
+++ b/Swiftgram/SGSettingsUI/Sources/AyuGramHistoryController.swift
@@ -0,0 +1,56 @@
+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import SGItemListUI
+
+private enum HistorySection: Int32, SGItemListSection { case actions, entries }
+private enum HistoryAction: Hashable { case clear }
+private typealias HistoryEntry = SGItemListUIEntry<HistorySection, Int, Int, Int, Int, HistoryAction>
+
+func ayuGramHistoryController(context: AccountContext) -> ViewController {
+    let records = Promise<[AyuGramHistoryEntry]>()
+    records.set(context.engine.ayuGramMessageHistory())
+    var presentClear: (() -> Void)?
+    let arguments = SGItemListArguments<Int, Int, Int, Int, HistoryAction>(context: context, action: { _ in presentClear?() })
+    let signal = combineLatest(context.sharedContext.presentationData, records.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, records -> (ItemListControllerState, (ItemListNodeState, SGItemListArguments<Int, Int, Int, Int, HistoryAction>)) in
+        let ru = ["ru", "uk"].contains(presentationData.strings.baseLanguageCode)
+        var entries: [HistoryEntry] = [
+            .action(id: 0, section: .actions, actionType: .clear, text: ru ? "Очистить историю" : "Clear history", kind: .destructive),
+            .notice(id: 1, section: .actions, text: ru ? "Локальная история текущего аккаунта. Записи старше 30 дней удаляются при открытии или добавлении новых. Это текстовые снимки, а не восстановление сообщений с сервера." : "Local to this account. Entries older than 30 days are removed when opened or updated. These are text snapshots, not server message recovery.")
+        ]
+        let formatter = DateFormatter()
+        formatter.dateStyle = .short
+        formatter.timeStyle = .medium
+        if records.isEmpty {
+            entries.append(.notice(id: 2, section: .entries, text: ru ? "История пуста" : "No history yet"))
+        }
+        for (index, record) in records.enumerated() {
+            let event = record.event == "edited" ? (ru ? "До правки" : "Before edit") : (ru ? "Удалено" : "Deleted")
+            let date = formatter.string(from: Date(timeIntervalSince1970: TimeInterval(record.timestamp)))
+            entries.append(.notice(id: index + 3, section: .entries, text: "\(record.peerTitle) · \(record.author)\n\(event) · \(date)\n\(record.text)"))
+        }
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Message History"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    presentClear = { [weak controller] in
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        let sheet = ActionSheetController(presentationData: data)
+        sheet.setItemGroups([
+            ActionSheetItemGroup(items: [ActionSheetButtonItem(title: data.strings.Common_Delete, color: .destructive, action: { [weak sheet] in
+                sheet?.dismissAnimated()
+                records.set(context.engine.ayuGramClearMessageHistory() |> mapToSignal { _ in context.engine.ayuGramMessageHistory() })
+            })]),
+            ActionSheetItemGroup(items: [ActionSheetButtonItem(title: data.strings.Common_Cancel, color: .accent, action: { [weak sheet] in sheet?.dismissAnimated() })])
+        ])
+        controller?.present(sheet, in: .window(.root))
+    }
+    return controller
+}
