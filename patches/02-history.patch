@@ -0,0 +1,61 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+import SGSimpleSettings
+
+public struct AyuGramHistoryEntry: Codable, Equatable {
+    public let peerId: Int64
+    public let messageId: Int32
+    public let peerTitle: String
+    public let author: String
+    public let text: String
+    public let event: String
+    public let timestamp: Int32
+}
+
+private struct AyuGramHistory: Codable {
+    var entries: [AyuGramHistoryEntry]
+}
+
+// Reserved application preference key, distinct from Telegram's built-in keys.
+private let ayuGramHistoryKey = applicationSpecificPreferencesKey(0x415955)
+
+func ayuGramRecordHistory(transaction: Transaction, ids: [MessageId], event: String) {
+    guard AyuGramSettings.shared.snapshot.messageHistory else { return }
+    var history = transaction.getPreferencesEntry(key: ayuGramHistoryKey)?.get(AyuGramHistory.self) ?? AyuGramHistory(entries: [])
+    let now = Int32(Date().timeIntervalSince1970)
+    history.entries.removeAll { $0.timestamp < now - 30 * 24 * 60 * 60 }
+    for id in ids {
+        guard id.namespace == Namespaces.Message.Cloud,
+              id.peerId.namespace != Namespaces.Peer.SecretChat,
+              let message = transaction.getMessage(id), !message.text.isEmpty,
+              !message.containsSecretMedia,
+              !message.attributes.contains(where: { $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute }) else { continue }
+        let entry = AyuGramHistoryEntry(peerId: id.peerId.toInt64(), messageId: id.id, peerTitle: String((transaction.getPeer(id.peerId)?.debugDisplayTitle ?? "Chat").prefix(256)), author: String((message.author?.debugDisplayTitle ?? "").prefix(256)), text: String(message.text.prefix(4096)), event: event, timestamp: now)
+        // Deduplicate replayed updates, but preserve distinct revisions.
+        if history.entries.last(where: { $0.peerId == entry.peerId && $0.messageId == entry.messageId && $0.event == entry.event })?.text != entry.text {
+            history.entries.append(entry)
+            if history.entries.count > 200 { history.entries.removeFirst(history.entries.count - 200) }
+        }
+    }
+    history.entries = Array(history.entries.suffix(200))
+    transaction.setPreferencesEntry(key: ayuGramHistoryKey, value: PreferencesEntry(history))
+}
+
+public extension TelegramEngine {
+    func ayuGramMessageHistory() -> Signal<[AyuGramHistoryEntry], NoError> {
+        return self.account.postbox.transaction { transaction in
+            var history = transaction.getPreferencesEntry(key: ayuGramHistoryKey)?.get(AyuGramHistory.self) ?? AyuGramHistory(entries: [])
+            let now = Int32(Date().timeIntervalSince1970)
+            history.entries.removeAll { $0.timestamp < now - 30 * 24 * 60 * 60 }
+            transaction.setPreferencesEntry(key: ayuGramHistoryKey, value: PreferencesEntry(history))
+            return Array(history.entries.reversed())
+        }
+    }
+
+    func ayuGramClearMessageHistory() -> Signal<Void, NoError> {
+        return self.account.postbox.transaction { transaction in
+            transaction.setPreferencesEntry(key: ayuGramHistoryKey, value: nil)
+        }
+    }
+}
