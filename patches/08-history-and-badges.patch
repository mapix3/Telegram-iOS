+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+import ItemListUI
+import SGStrings
+
+final class AyuGramHistoryCardItem: ListViewItem, ItemListItem {
+    let context: AccountContext
+    let data: ItemListPresentationData
+    let record: AyuGramHistoryEntry
+    let sectionId: ItemListSectionId
+    let openAuthor: () -> Void
+    let openChat: () -> Void
+    let openMedia: () -> Void
+    var isAlwaysPlain: Bool { true }
+    init(context: AccountContext, data: ItemListPresentationData, record: AyuGramHistoryEntry, sectionId: ItemListSectionId, openAuthor: @escaping () -> Void, openChat: @escaping () -> Void, openMedia: @escaping () -> Void) {
+        self.context = context
+        self.data = data
+        self.record = record
+        self.sectionId = sectionId
+        self.openAuthor = openAuthor
+        self.openChat = openChat
+        self.openMedia = openMedia
+    }
+    func nodeConfiguredForParams(async: @escaping (@escaping () -> Void) -> Void, params: ListViewItemLayoutParams, synchronousLoads: Bool, previousItem: ListViewItem?, nextItem: ListViewItem?, completion: @escaping (ListViewItemNode, @escaping () -> (Signal<Void, NoError>?, (ListViewItemApply) -> Void)) -> Void) {
+        Queue.mainQueue().async {
+            let node = AyuGramHistoryCardNode()
+            let layout = node.update(self, width: params.width, leftInset: params.leftInset, rightInset: params.rightInset)
+            node.contentSize = layout.contentSize
+            node.insets = layout.insets
+            completion(node, { (nil, { _ in }) })
+        }
+    }
+    func updateNode(async: @escaping (@escaping () -> Void) -> Void, node: @escaping () -> ListViewItemNode, params: ListViewItemLayoutParams, previousItem: ListViewItem?, nextItem: ListViewItem?, animation: ListViewItemUpdateAnimation, completion: @escaping (ListViewItemNodeLayout, @escaping (ListViewItemApply) -> Void) -> Void) {
+        Queue.mainQueue().async {
+            guard let node = node() as? AyuGramHistoryCardNode else { return }
+            let layout = node.update(self, width: params.width, leftInset: params.leftInset, rightInset: params.rightInset)
+            completion(layout, { _ in })
+        }
+    }
+}
+
+private final class AyuGramHistoryCardNode: ListViewItemNode {
+    private let bubble = UIView()
+    private let chat = UIButton(type: .system)
+    private let author = UIButton(type: .system)
+    private let event = UILabel()
+    private let current = UILabel()
+    private let body = UILabel()
+    private let quoteLine = UIView()
+    private let time = UILabel()
+    private let thumbnail = UIImageView()
+    private let media = UIButton(type: .system)
+    private var item: AyuGramHistoryCardItem?
+    init() {
+        super.init(layerBacked: false)
+        view.addSubview(chat)
+        view.addSubview(bubble)
+        for child in [author, event, current, body, quoteLine, time, thumbnail, media] { bubble.addSubview(child) }
+        bubble.layer.cornerRadius = 18
+        chat.contentHorizontalAlignment = .leading
+        author.contentHorizontalAlignment = .leading
+        author.titleLabel?.lineBreakMode = .byTruncatingTail
+        chat.titleLabel?.lineBreakMode = .byTruncatingTail
+        body.numberOfLines = 0
+        current.numberOfLines = 0
+        thumbnail.contentMode = .scaleAspectFill
+        thumbnail.clipsToBounds = true
+        thumbnail.layer.cornerRadius = 10
+        chat.addTarget(self, action: #selector(openChat), for: .touchUpInside)
+        author.addTarget(self, action: #selector(openAuthor), for: .touchUpInside)
+        media.addTarget(self, action: #selector(openMedia), for: .touchUpInside)
+    }
+    @objc private func openChat() { item?.openChat() }
+    @objc private func openAuthor() { item?.openAuthor() }
+    @objc private func openMedia() { item?.openMedia() }
+    func update(_ item: AyuGramHistoryCardItem, width: CGFloat, leftInset: CGFloat, rightInset: CGFloat) -> ListViewItemNodeLayout {
+        self.item = item
+        let record = item.record
+        let theme = item.data.theme
+        let locale = item.data.strings.baseLanguageCode
+        let accent = theme.list.itemAccentColor
+        let textColor = theme.list.itemPrimaryTextColor
+        let secondary = theme.list.itemSecondaryTextColor
+        let available = max(80, width - leftInset - rightInset - 48)
+        let contentWidth = available - 28
+        bubble.backgroundColor = theme.list.itemBlocksBackgroundColor
+        chat.setTitle(record.peerTitle, for: .normal)
+        chat.setTitleColor(secondary, for: .normal)
+        chat.titleLabel?.font = UIFont.systemFont(ofSize: 12)
+        chat.accessibilityHint = item.data.strings.VoiceOver_Chat_GoToOriginalMessage
+        author.setTitle(record.author.isEmpty ? record.peerTitle : record.author, for: .normal)
+        author.setTitleColor(accent, for: .normal)
+        author.titleLabel?.font = UIFont.systemFont(ofSize: 15, weight: .semibold)
+        author.isEnabled = record.authorId != nil
+        event.font = UIFont.systemFont(ofSize: 12, weight: .medium)
+        event.textColor = accent
+        event.text = i18n(record.event == "edited" ? "Ayu.BeforeEdit" : "Ayu.Deleted", locale)
+        body.font = UIFont.systemFont(ofSize: 16)
+        body.textColor = textColor
+        body.text = record.text
+        current.font = body.font
+        current.textColor = textColor
+        current.text = record.updatedText
+        current.isHidden = record.event != "edited" || record.updatedText == nil
+        body.accessibilityLabel = record.text
+        quoteLine.backgroundColor = accent
+        quoteLine.layer.cornerRadius = 1.5
+        quoteLine.isHidden = record.event != "edited"
+        let textX: CGFloat = record.event == "edited" ? 23 : 14
+        let textWidth = contentWidth - (textX - 14)
+        let bodyHeight = ceil((record.text as NSString).boundingRect(with: CGSize(width: textWidth, height: .greatestFiniteMagnitude), options: [.usesLineFragmentOrigin, .usesFontLeading], attributes: [.font: body.font!], context: nil).height)
+        author.frame = CGRect(x: 14, y: 8, width: contentWidth, height: 28)
+        let currentHeight = current.isHidden ? 0 : ceil(((record.updatedText ?? "") as NSString).boundingRect(with: CGSize(width: contentWidth, height: .greatestFiniteMagnitude), options: [.usesLineFragmentOrigin, .usesFontLeading], attributes: [.font: current.font!], context: nil).height)
+        current.frame = CGRect(x: 14, y: 38, width: contentWidth, height: currentHeight)
+        let quoteTop: CGFloat = current.isHidden ? 38 : current.frame.maxY + 10
+        event.frame = CGRect(x: textX, y: quoteTop, width: textWidth, height: 18)
+        body.frame = CGRect(x: textX, y: quoteTop + 22, width: textWidth, height: max(0, bodyHeight))
+        quoteLine.frame = CGRect(x: 14, y: quoteTop + 2, width: 3, height: 20 + bodyHeight)
+        var bottom = body.frame.maxY + 10
+        thumbnail.image = nil
+        thumbnail.isHidden = true
+        media.isHidden = true
+        if let name = record.photoFileName, let url = item.context.engine.ayuGramArchivedPhotoURL(name), FileManager.default.fileExists(atPath: url.path) {
+            let kind = record.mediaKind ?? "photo"
+            if kind == "photo", let image = UIImage(contentsOfFile: url.path) {
+                thumbnail.image = image
+                thumbnail.isHidden = false
+                let ratio = image.size.width > 0 ? image.size.height / image.size.width : 1
+                let height = min(230, max(100, contentWidth * ratio))
+                thumbnail.frame = CGRect(x: 14, y: bottom, width: contentWidth, height: height)
+                media.frame = thumbnail.frame
+                media.setTitle(nil, for: .normal)
+                media.setImage(nil, for: .normal)
+                media.accessibilityLabel = item.data.strings.Settings_ViewPhoto
+                bottom += height + 10
+            } else {
+                media.setImage(UIImage(systemName: kind == "video" ? "play.circle.fill" : "doc.fill"), for: .normal)
+                media.setTitle("  " + (record.mediaTitle ?? (kind == "video" ? item.data.strings.Message_Video : item.data.strings.Message_File)), for: .normal)
+                media.titleLabel?.lineBreakMode = .byTruncatingMiddle
+                media.frame = CGRect(x: 14, y: bottom, width: contentWidth, height: 52)
+                media.accessibilityLabel = media.title(for: .normal)
+                bottom += 62
+            }
+            media.tintColor = accent
+            media.isHidden = false
+        }
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: locale)
+        formatter.dateStyle = .short
+        formatter.timeStyle = .short
+        time.text = (record.event == "deleted" ? "🗑︎ " : "↺ ") + formatter.string(from: Date(timeIntervalSince1970: TimeInterval(record.timestamp)))
+        time.font = UIFont.systemFont(ofSize: 11)
+        time.textColor = secondary
+        time.textAlignment = .right
+        time.frame = CGRect(x: 14, y: bottom, width: contentWidth, height: 18)
+        bottom += 26
+        chat.frame = CGRect(x: leftInset + 24, y: 4, width: available, height: 25)
+        bubble.frame = CGRect(x: leftInset + 24, y: 33, width: available, height: bottom)
+        return ListViewItemNodeLayout(contentSize: CGSize(width: width, height: bottom + 45), insets: .zero)
+    }
+}
