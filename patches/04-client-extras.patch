--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Messages/AyuGramEmojiLinks.swift
@@ -0,0 +1,72 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+import SGSimpleSettings
+
+public func ayuEmojiFileIdFromLink(_ url: String) -> Int64? {
+    guard let components = URLComponents(string: url), components.scheme == "https",
+          components.host == "t.me", components.path.hasPrefix("/addemoji/"),
+          components.path.count > "/addemoji/".count,
+          let fragment = components.fragment, fragment.hasPrefix("ayuemoji_"),
+          let id = Int64(fragment.dropFirst("ayuemoji_".count)), id != 0 else { return nil }
+    return id
+}
+
+/// Convert only new text/caption entities. Files, other formatting and ranges
+/// stay untouched; the original text already contains the native emoji alt.
+func ayuPrepareEmojiLinks(account: Account, peerId: PeerId, messages: [(Bool, EnqueueMessage)]) -> Signal<[(Bool, EnqueueMessage)], NoError> {
+    guard AyuGramSettings.shared.client.localPremium,
+          peerId.namespace != Namespaces.Peer.SecretChat else { return .single(messages) }
+    var ids = Set<Int64>()
+    for (_, message) in messages {
+        if case .message = message {
+            for attribute in message.attributes {
+                if let attribute = attribute as? TextEntitiesMessageAttribute {
+                    for entity in attribute.ayuWireEntities {
+                        if case let .CustomEmoji(_, fileId) = entity.type { ids.insert(fileId) }
+                    }
+                }
+            }
+        }
+    }
+    guard !ids.isEmpty else { return .single(messages) }
+    return _internal_resolveInlineStickers(postbox: account.postbox, network: account.network, fileIds: Array(ids))
+    |> mapToSignal { files -> Signal<[(Bool, EnqueueMessage)], NoError> in
+        var nameSignals: [Signal<(Int64, String?), NoError>] = []
+        for fileId in ids.sorted() {
+            var reference: StickerPackReference?
+            for attribute in files[fileId]?.attributes ?? [] {
+                if case let .CustomEmoji(_, _, _, pack) = attribute { reference = pack }
+            }
+            guard let reference else { nameSignals.append(.single((fileId, nil))); continue }
+            nameSignals.append(_internal_loadedStickerPack(postbox: account.postbox, network: account.network, reference: reference, forceActualized: false)
+            |> filter { pack in if case .fetching = pack { return false }; return true }
+            |> take(1)
+            |> map { pack -> (Int64, String?) in
+                if case let .result(info, _, _) = pack, !info.shortName.isEmpty { return (fileId, info.shortName) }
+                return (fileId, nil)
+            })
+        }
+        return combineLatest(nameSignals)
+        |> map { pairs in
+            var names: [Int64: String] = [:]
+            for (id, name) in pairs { if let name { names[id] = name } }
+            return messages.map { transformed, message in
+                guard case .message = message else { return (transformed, message) }
+                return (transformed, message.withUpdatedAttributes { attributes in
+                    attributes.map { attribute -> MessageAttribute in
+                        guard let attribute = attribute as? TextEntitiesMessageAttribute else { return attribute }
+                        let entities = attribute.ayuWireEntities.compactMap { entity -> MessageTextEntity? in
+                            guard case let .CustomEmoji(_, fileId) = entity.type else { return entity }
+                            // Offline/unavailable pack: retain ordinary alt emoji,
+                            // never send a premium entity or invent a broken URL.
+                            guard let name = names[fileId] else { return nil }
+                            return MessageTextEntity(range: entity.range, type: .TextUrl(url: "https://t.me/addemoji/" + name + "#ayuemoji_" + String(fileId)))
+                        }
+                        return TextEntitiesMessageAttribute(entities: entities)
+                    }
+                })
+            }
+        }
+    }
+}
