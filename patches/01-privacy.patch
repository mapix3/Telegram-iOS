@@ -0,0 +1,55 @@
+import Foundation
+import Display
+import SwiftSignalKit
+import AccountContext
+import TelegramPresentationData
+import PresentationDataUtils
+import ItemListUI
+import SGItemListUI
+import SGSimpleSettings
+
+private enum AyuSection: Int32, SGItemListSection { case privacy, history, limits }
+private enum AyuToggle: Hashable { case ghost, read, online, typing, recording, uploading, stories }
+private enum AyuUnused: Hashable { case unused }
+private typealias AyuEntry = SGItemListUIEntry<AyuSection, AyuToggle, AyuUnused, AyuUnused, AyuUnused, AyuUnused>
+
+public func ayuGramSettingsController(context: AccountContext) -> ViewController {
+    let changed = ValuePromise<Int>(0, ignoreRepeated: false)
+    let arguments = SGItemListArguments<AyuToggle, AyuUnused, AyuUnused, AyuUnused, AyuUnused>(context: context, setBoolValue: { key, enabled in
+        AyuGramSettings.shared.update { settings in
+            switch key {
+            case .ghost: settings.ghostMode = enabled
+            case .read: settings.antiRead = enabled
+            case .online: settings.antiOnline = enabled
+            case .typing: settings.antiTyping = enabled
+            case .recording: settings.antiRecording = enabled
+            case .uploading: settings.antiUploading = enabled
+            case .stories: settings.storyPrivacy = enabled
+            }
+        }
+        changed.set(0)
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, changed.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, SGItemListArguments<AyuToggle, AyuUnused, AyuUnused, AyuUnused, AyuUnused>)) in
+        let settings = AyuGramSettings.shared.snapshot
+        let ru = ["ru", "uk"].contains(presentationData.strings.baseLanguageCode)
+        let entries: [AyuEntry] = [
+            .header(id: 0, section: .privacy, text: "AyuGram / Privacy", badge: nil),
+            .toggle(id: 1, section: .privacy, settingName: .ghost, value: settings.ghostMode, text: "Ghost Mode", enabled: true),
+            .toggle(id: 2, section: .privacy, settingName: .read, value: settings.suppressRead, text: "Anti Read", enabled: !settings.ghostMode),
+            .toggle(id: 3, section: .privacy, settingName: .online, value: settings.suppressOnline, text: "Anti Online", enabled: !settings.ghostMode),
+            .toggle(id: 4, section: .privacy, settingName: .typing, value: settings.suppressTyping, text: "Anti Typing", enabled: !settings.ghostMode),
+            .toggle(id: 5, section: .privacy, settingName: .recording, value: settings.suppressRecording, text: "Anti Recording", enabled: !settings.ghostMode),
+            .toggle(id: 6, section: .privacy, settingName: .uploading, value: settings.suppressUploading, text: "Anti Uploading", enabled: !settings.ghostMode),
+            .toggle(id: 7, section: .privacy, settingName: .stories, value: settings.suppressStoryViews, text: "Story Privacy", enabled: !settings.ghostMode),
+            .notice(id: 8, section: .privacy, text: ru ? "Для всех аккаунтов на этом устройстве. Ghost Mode включает ограничения выше, сохраняя ваши отдельные настройки. Уже отправленные запросы отменить нельзя." : "Applies to every account on this device. Ghost Mode overrides the switches above and preserves their individual values. Requests already sent cannot be recalled."),
+            .header(id: 20, section: .limits, text: ru ? "Как это работает" : "How it works", badge: nil),
+            .notice(id: 21, section: .limits, text: ru ? "Anti Read подавляет исходящие отметки чтения и прослушивания. Счётчики могут оставаться непрочитанными. После выключения следующее чтение может подтвердить предыдущие сообщения. Story Privacy оставляет истории непросмотренными." : "Anti Read suppresses outgoing read and playback receipts. Unread counters may remain. After disabling it, later reading can acknowledge earlier messages. Story Privacy leaves stories unseen."),
+            .notice(id: 22, section: .limits, text: ru ? "Anti Online скрывает явные обновления статуса. Отправка сообщений, другие устройства и действия на сервере могут раскрыть активность. Звонки не скрываются. Anti Uploading скрывает индикатор, а не передачу файла." : "Anti Online suppresses explicit presence updates. Sending messages, other devices and server behavior may reveal activity. Calls are not hidden. Anti Uploading hides the indicator, not the file transfer.")
+        ]
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("AyuGram / Privacy"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks), arguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
