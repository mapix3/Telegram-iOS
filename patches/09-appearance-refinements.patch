+final class AyuGramAppearancePreviewItem: ListViewItem, ItemListItem {
+    let data: ItemListPresentationData
+    let scope: AyuGramAppearanceScope
+    let settings: AyuGramAppearanceSettings
+    let sectionId: ItemListSectionId
+    var isAlwaysPlain: Bool { true }
+    init(data: ItemListPresentationData, scope: AyuGramAppearanceScope, settings: AyuGramAppearanceSettings, sectionId: ItemListSectionId) {
+        self.data = data
+        self.scope = scope
+        self.settings = settings
+        self.sectionId = sectionId
+    }
+    func nodeConfiguredForParams(async: @escaping (@escaping () -> Void) -> Void, params: ListViewItemLayoutParams, synchronousLoads: Bool, previousItem: ListViewItem?, nextItem: ListViewItem?, completion: @escaping (ListViewItemNode, @escaping () -> (Signal<Void, NoError>?, (ListViewItemApply) -> Void)) -> Void) {
+        Queue.mainQueue().async {
+            let node = AyuGramAppearancePreviewNode(scope: self.scope)
+            let layout = node.update(self, params: params)
+            node.contentSize = layout.contentSize
+            node.insets = layout.insets
+            completion(node, { (nil, { _ in }) })
+        }
+    }
+    func updateNode(async: @escaping (@escaping () -> Void) -> Void, node: @escaping () -> ListViewItemNode, params: ListViewItemLayoutParams, previousItem: ListViewItem?, nextItem: ListViewItem?, animation: ListViewItemUpdateAnimation, completion: @escaping (ListViewItemNodeLayout, @escaping (ListViewItemApply) -> Void) -> Void) {
+        Queue.mainQueue().async {
+            guard let node = node() as? AyuGramAppearancePreviewNode else { return }
+            completion(node.update(self, params: params), { _ in })
+        }
+    }
+}
+
+private final class AyuGramAppearancePreviewNode: ListViewItemNode {
+    private let card = UIView()
+    private let backdrop: AyuGramBackdropView
+    private let incoming = UILabel()
+    private let outgoing = UILabel()
+    private let title = UILabel()
+    private let scope: AyuGramAppearanceScope
+    init(scope: AyuGramAppearanceScope) {
+        self.scope = scope
+        self.backdrop = AyuGramBackdropView(scope: scope)
+        super.init(layerBacked: false)
+        card.isUserInteractionEnabled = false
+        card.clipsToBounds = true
+        card.layer.cornerRadius = 20
+        view.addSubview(card)
+        for child in [backdrop, title, incoming, outgoing] { card.addSubview(child) }
+        for label in [incoming, outgoing] {
+            label.numberOfLines = 2
+            label.font = UIFont.systemFont(ofSize: 14)
+            label.layer.cornerRadius = 12
+            label.clipsToBounds = true
+            label.textAlignment = .center
+        }
+        title.font = UIFont.systemFont(ofSize: 15, weight: .semibold)
+        title.textAlignment = .center
+    }
+    func update(_ item: AyuGramAppearancePreviewItem, params: ListViewItemLayoutParams) -> ListViewItemNodeLayout {
+        let theme = item.data.theme
+        let width = max(160, params.width - params.leftInset - params.rightInset - 32)
+        card.frame = CGRect(x: params.leftInset + 16, y: 12, width: width, height: 210)
+        card.backgroundColor = theme.list.itemBlocksBackgroundColor
+        backdrop.frame = card.bounds
+        backdrop.overlayColor = theme.list.blocksBackgroundColor
+        backdrop.reload()
+        title.text = scope == .chatList ? item.data.strings.DialogList_Title : item.data.strings.Wallpaper_Title
+        title.textColor = theme.list.itemPrimaryTextColor
+        title.frame = CGRect(x: 12, y: 12, width: width - 24, height: 30)
+        incoming.text = item.data.strings.Appearance_PreviewIncomingText
+        outgoing.text = item.data.strings.Appearance_PreviewOutgoingText
+        incoming.textColor = theme.list.itemPrimaryTextColor
+        outgoing.textColor = scope == .chatList ? theme.list.itemPrimaryTextColor : theme.list.itemCheckColors.foregroundColor
+        let opacity = CGFloat(item.settings.rowOpacity)
+        incoming.backgroundColor = theme.list.itemBlocksBackgroundColor.withAlphaComponent(scope == .chatList ? opacity : 0.9)
+        outgoing.backgroundColor = scope == .chatList ? incoming.backgroundColor : theme.list.itemAccentColor
+        let bubbleWidth = scope == .chatList ? width - 24 : min(width - 40, width * 0.76)
+        incoming.frame = CGRect(x: 12, y: 62, width: bubbleWidth, height: 56)
+        outgoing.frame = CGRect(x: scope == .chatList ? 12 : width - bubbleWidth - 12, y: 130, width: bubbleWidth, height: 56)
+        return ListViewItemNodeLayout(contentSize: CGSize(width: params.width, height: 234), insets: .zero)
+    }
+}
