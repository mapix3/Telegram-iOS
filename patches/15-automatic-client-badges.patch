+public final class AyuGramClientBadges {
+    public static let shared = AyuGramClientBadges()
+    public static let didChange = Notification.Name("AyuGram.ClientBadges.didChange")
+    public static let baseURL = URL(string: "https://ayugram-sync.ayugram-status.workers.dev")!
+    private struct Member: Codable { var telegramId: String; var registered: Bool }
+    private struct Lookup: Decodable { var members: [Member] }
+    private struct Cached: Codable { var registered: Bool; var checkedAt: TimeInterval; var generation: Int64 }
+    private let lock = NSLock()
+    private let defaults: UserDefaults
+    private let session: URLSession
+    private let cacheKey = "ayugram.client-badges.cache.v1"
+    private var cache: [String: Cached] = [:]
+    private var visible: [Int64: TimeInterval] = [:]
+    private var activeAccount: Int64?
+    private var foreground = true
+    private var nextRequestAt: TimeInterval = 0
+    private var ownRegistrationAt: TimeInterval = 0
+    private var retryDelay: TimeInterval = 5
