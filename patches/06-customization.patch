+import Foundation
+import UIKit
+import PhotosUI
+import Display
+import AccountContext
+import TelegramPresentationData
+import SGSimpleSettings
+import SGStrings
+
+final class AyuGramAppearanceController: UIViewController, UIImagePickerControllerDelegate, UINavigationControllerDelegate {
+    private let context: AccountContext
+    private var stack: UIStackView!
+    private var pickingVideo = false
+    init(context: AccountContext) { self.context = context; super.init(nibName: nil, bundle: nil) }
+    required init?(coder: NSCoder) { fatalError() }
+    private var strings: PresentationStrings { context.sharedContext.currentPresentationData.with { $0 }.strings }
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = .systemBackground
+        title = strings.Appearance_Title
+        navigationItem.leftBarButtonItem = UIBarButtonItem(title: strings.Common_Close, style: .plain, target: self, action: #selector(close))
+        let scroll = UIScrollView()
+        scroll.translatesAutoresizingMaskIntoConstraints = false
+        view.addSubview(scroll)
+        stack = UIStackView()
+        stack.axis = .vertical
+        stack.spacing = 18
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        scroll.addSubview(stack)
+        NSLayoutConstraint.activate([scroll.leadingAnchor.constraint(equalTo: view.leadingAnchor), scroll.trailingAnchor.constraint(equalTo: view.trailingAnchor), scroll.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor), scroll.bottomAnchor.constraint(equalTo: view.bottomAnchor), stack.leadingAnchor.constraint(equalTo: scroll.contentLayoutGuide.leadingAnchor, constant: 20), stack.trailingAnchor.constraint(equalTo: scroll.contentLayoutGuide.trailingAnchor, constant: -20), stack.topAnchor.constraint(equalTo: scroll.contentLayoutGuide.topAnchor, constant: 20), stack.bottomAnchor.constraint(equalTo: scroll.contentLayoutGuide.bottomAnchor, constant: -30), stack.widthAnchor.constraint(equalTo: scroll.frameLayoutGuide.widthAnchor, constant: -40)])
+        button(strings.Common_ChoosePhoto, action: #selector(choosePhoto))
+        button(strings.Message_Video, action: #selector(chooseVideo))
+        let settings = AyuGramAppearance.shared.settings
+        toggle(strings.DialogList_Title, value: settings.chatList, tag: 0)
+        toggle(strings.Wallpaper_Title, value: settings.conversations, tag: 1)
+        toggle(strings.WallpaperPreview_Motion, value: settings.animateVideo, tag: 2)
+        slider(strings.PhotoEditor_ContrastTool, value: settings.dim, tag: 0, minimum: 0.2, maximum: 0.9)
+        slider(strings.WallpaperPreview_Blurred, value: settings.blur, tag: 1, minimum: 0, maximum: 1)
+        slider(i18n("Ayu.RowOpacity", strings.baseLanguageCode), value: settings.rowOpacity, tag: 2, minimum: 0.35, maximum: 1)
+        button(strings.AutoDownloadSettings_Reset, action: #selector(reset))
+    }
+    private func button(_ title: String, action: Selector) {
+        let button = UIButton(type: .system)
+        button.setTitle(title, for: .normal)
+        button.contentHorizontalAlignment = .leading
+        button.addTarget(self, action: action, for: .touchUpInside)
+        stack.addArrangedSubview(button)
+    }
+    private func toggle(_ text: String, value: Bool, tag: Int) {
+        let row = UIStackView()
+        let label = UILabel()
+        label.text = text
+        label.numberOfLines = 0
+        let control = UISwitch()
+        control.isOn = value
+        control.tag = tag
+        control.addTarget(self, action: #selector(toggleChanged(_:)), for: .valueChanged)
+        row.addArrangedSubview(label)
+        row.addArrangedSubview(control)
+        stack.addArrangedSubview(row)
+    }
+    private func slider(_ text: String, value: Float, tag: Int, minimum: Float, maximum: Float) {
+        let label = UILabel()
+        label.text = text
+        label.numberOfLines = 0
+        stack.addArrangedSubview(label)
+        let control = UISlider()
+        control.minimumValue = minimum
+        control.maximumValue = maximum
+        control.value = value
+        control.tag = tag
+        control.accessibilityLabel = text
+        control.addTarget(self, action: #selector(sliderChanged(_:)), for: .valueChanged)
+        stack.addArrangedSubview(control)
+    }
+    @objc private func toggleChanged(_ control: UISwitch) {
+        AyuGramAppearance.shared.update { settings in
+            switch control.tag { case 0: settings.chatList = control.isOn; case 1: settings.conversations = control.isOn; default: settings.animateVideo = control.isOn }
+        }
+    }
+    @objc private func sliderChanged(_ control: UISlider) {
+        AyuGramAppearance.shared.update { settings in
+            switch control.tag { case 0: settings.dim = control.value; case 1: settings.blur = control.value; default: settings.rowOpacity = control.value }
+        }
+    }
+    @objc private func choosePhoto() { choose(video: false) }
+    @objc private func chooseVideo() { choose(video: true) }
+    private func choose(video: Bool) {
+        pickingVideo = video
+        if #available(iOS 14.0, *) {
+            chooseModern(video: video)
+        } else {
+            let picker = UIImagePickerController()
+            picker.sourceType = .photoLibrary
+            picker.mediaTypes = [video ? "public.movie" : "public.image"]
+            picker.delegate = self
+            present(picker, animated: true)
+        }
+    }
+    @available(iOS 14.0, *)
+    private func chooseModern(video: Bool) {
+        var configuration = PHPickerConfiguration(photoLibrary: .shared())
+        configuration.filter = video ? .videos : .images
+        configuration.selectionLimit = 1
+        let picker = PHPickerViewController(configuration: configuration)
+        picker.delegate = self
+        present(picker, animated: true)
+    }
+    func imagePickerControllerDidCancel(_ picker: UIImagePickerController) {
+        picker.dismiss(animated: true)
+    }
+    func imagePickerController(_ picker: UIImagePickerController, didFinishPickingMediaWithInfo info: [UIImagePickerController.InfoKey: Any]) {
+        picker.dismiss(animated: true)
+        do {
+            if let url = info[pickingVideo ? .mediaURL : .imageURL] as? URL {
+                try AyuGramAppearance.shared.importMedia(url, isVideo: pickingVideo)
+            } else if !pickingVideo, let image = info[.originalImage] as? UIImage, let data = image.jpegData(compressionQuality: 0.95) {
+                let temporary = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString + ".jpg")
+                defer { try? FileManager.default.removeItem(at: temporary) }
+                try data.write(to: temporary, options: .atomic)
+                try AyuGramAppearance.shared.importMedia(temporary, isVideo: false)
+            } else {
+                throw CocoaError(.fileReadCorruptFile)
+            }
+        } catch {
+            showImportError()
+        }
+    }
+    private func showImportError() {
+        DispatchQueue.main.async { [weak self] in
+            guard let self else { return }
+            let alert = UIAlertController(title: nil, message: i18n("Ayu.MediaImportError", self.strings.baseLanguageCode), preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: self.strings.Common_OK, style: .default))
+            self.present(alert, animated: true)
+        }
+    }
+    @objc private func close() { dismiss(animated: true) }
+    @objc private func reset() { AyuGramAppearance.shared.reset(); dismiss(animated: true) }
+}
+
+@available(iOS 14.0, *)
+extension AyuGramAppearanceController: PHPickerViewControllerDelegate {
+    func picker(_ picker: PHPickerViewController, didFinishPicking results: [PHPickerResult]) {
+        picker.dismiss(animated: true)
+        guard let provider = results.first?.itemProvider else { return }
+        let video = pickingVideo
+        provider.loadFileRepresentation(forTypeIdentifier: video ? "public.movie" : "public.image") { [weak self] url, error in
+            do {
+                guard error == nil, let url else { throw CocoaError(.fileReadCorruptFile) }
+                try AyuGramAppearance.shared.importMedia(url, isVideo: video)
+            } catch {
+                self?.showImportError()
+            }
+        }
+    }
+}
